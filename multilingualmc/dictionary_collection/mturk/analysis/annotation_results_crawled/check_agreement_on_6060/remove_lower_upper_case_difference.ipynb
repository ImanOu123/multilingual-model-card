    "import pandas as pd\n",
    "\n",
    "langs = ['Arabic', 'Chinese', 'French', 'Japanese', 'Russian']\n",
    "\n",
    "for lang in langs:\n",
    "    df = pd.read_csv(f\"{lang}.csv\")\n",
    "    filtered_df = df[df['annotation6060'].str.lower() != df['label6060'].str.lower()]\n",
    "    filtered_df.to_csv(f\"{lang}.csv\", index=False)"
   ]
  }
